addrcwa;
set("name","RCWA");
set("simulation region","3D");
set("propagation axis","z");
set("propagation direction","forward");
set("x",0);
set("y",0);
set("x span",1.0000000000000002e-06);
set("y span",1.0000000000000001e-07);
set("z min",-2e-08);
set("z max",1.0020000000000001e-05);
set("interface position","absolute");
set("interface absolute positions",[0,1.0000000000000001e-05]);
set("k vectors domain","rectangular");
set("max number ku",17);
set("max number kv",1);
set("mesh type","custom");
set("mesh cells x",128);
set("mesh cells y",10);
set("mesh cells z",10);
set("fit materials with multi-coefficient model",0);
set("incident angle","single");
set("angle theta",8);
set("angle phi",0);
set("frequency center",473605778830963.62);
set("frequency span",0);
set("frequency points",1);
set("report grating power",1);
set("report grating characterization",1);
set("report grating orders",1);
set("report field amplitudes",1);
run("RCWA");
power=getresult("RCWA","grating_power");
amplitudes=getresult("RCWA","grating_characterization");
totals=getresult("RCWA","total_energy");
modes=getresult("RCWA","grating_orders");
fields=getresult("RCWA","field_amplitudes");
matlabsave("rcwa_output.mat",power,amplitudes,totals,modes,fields);
